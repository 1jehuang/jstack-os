{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.os/schemas/installer/v1/staging-evidence.schema.json",
  "title": "JStack durable staging evidence",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_digest",
    "acceptance_state_hash",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_digest": { "$ref": "#/$defs/hash256" },
    "acceptance_state_hash": { "$ref": "#/$defs/hash256" },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/esp_loader" },
        { "$ref": "#/$defs/installer_uki" },
        { "$ref": "#/$defs/offline_system_image" },
        { "$ref": "#/$defs/recovery_uki" }
      ],
      "items": false
    }
  },
  "$defs": {
    "hash256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "esp_loader": {
      "type": "object",
      "required": ["role", "size_bytes", "sha256"],
      "properties": {
        "role": { "const": "esp_loader" },
        "size_bytes": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/hash256" }
      },
      "additionalProperties": false
    },
    "installer_uki": {
      "type": "object",
      "required": ["role", "size_bytes", "sha256"],
      "properties": {
        "role": { "const": "installer_uki" },
        "size_bytes": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/hash256" }
      },
      "additionalProperties": false
    },
    "offline_system_image": {
      "type": "object",
      "required": ["role", "size_bytes", "sha256"],
      "properties": {
        "role": { "const": "offline_system_image" },
        "size_bytes": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/hash256" }
      },
      "additionalProperties": false
    },
    "recovery_uki": {
      "type": "object",
      "required": ["role", "size_bytes", "sha256"],
      "properties": {
        "role": { "const": "recovery_uki" },
        "size_bytes": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/hash256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
