  "physical_only": [
    {
      "id": "HW-01",
      "observation": "Firmware Boot#### creation, BootNext reliability, bounded rearm, and reset behaviour on each declared device"
    },
    {
      "id": "HW-02",
      "observation": "Secure Boot chain and key-enrollment behaviour of each vendor firmware"
    },
