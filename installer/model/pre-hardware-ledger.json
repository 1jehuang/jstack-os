          "path": "controller/tests/fault_campaign.rs"
        },
        {
          "kind": "absent",
          "path": "controller/tests/fault_campaign.rs",
          "pattern": "const CASES|HAND_WRITTEN",
          "why": "cases are derived from the graph, never from a hand-written list"
        }
      ],
      "open_boundary": "The virtual campaign is complete; the disposable-VM campaign is open.",
      "requires_vm_observation": true
    },
    {
      "id": "PH-15",
      "title": "Repetition and freshness",
      "level": "A2",
