{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.os/schemas/installer/v1/release-acceptance-state.schema.json",
  "title": "Durable JStack release anti-rollback acceptance state",
  "type": "object",
  "required": [
    "schema_version",
    "channel",
    "state_model_sha256",
    "highest_sequence",
    "manifest_digest",
    "issued_at_unix_secs",
    "trusted_time_unix_secs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "state_model_sha256": {
      "$ref": "common.schema.json#/$defs/hash256"
    },
    "highest_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifest_digest": {
      "$ref": "common.schema.json#/$defs/hash256"
    },
    "issued_at_unix_secs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "trusted_time_unix_secs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
