{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.os/schemas/installer/v1/confirmation.schema.json",
  "title": "JStack plan confirmation",
  "type": "object",
  "required": [
    "schema_version",
    "plan_hash",
    "display_digest",
    "confirmed_at_unix_ms",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_hash": {
      "$ref": "common.schema.json#/$defs/hash256"
    },
    "display_digest": {
      "$ref": "common.schema.json#/$defs/hash256"
    },
    "confirmed_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "authorization": {
      "$ref": "common.schema.json#/$defs/nonempty"
    }
  },
  "additionalProperties": false
}
